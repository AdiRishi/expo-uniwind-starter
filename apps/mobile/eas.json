{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.13.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EAS_GRADLE_CACHE": "1",
        "EAS_USE_CACHE": "1"
      }
    },
    "preview": {
      "node": "24.13.0",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EAS_GRADLE_CACHE": "1",
        "EAS_USE_CACHE": "1"
      }
    },
    "production": {
      "node": "24.13.0",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EAS_GRADLE_CACHE": "1",
        "EAS_USE_CACHE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
