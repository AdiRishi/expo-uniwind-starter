# Copy to .env and adjust. Only EXPO_PUBLIC_* reaches the app bundle.

# Where the mobile app looks for the Nitro API.
# Defaults to http://localhost:3000 (http://10.0.2.2:3000 on Android emulators),
# so you only need this when pointing at a deployed API.
# EXPO_PUBLIC_API_URL=https://your-api.workers.dev

# Selects the build variant in apps/mobile/app.config.ts: development | preview | production.
# EAS build profiles set this for you; only override it for local variant builds.
# APP_VARIANT=development
