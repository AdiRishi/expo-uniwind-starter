{
  "name": "expo-uniwind-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "pnpm run test:app && pnpm run server:test",
    "test:app": "jest",
    "test:app:types": "tsc --noEmit -p tests/tsconfig.json",
    "typecheck": "tsc --noEmit && pnpm run test:app:types && pnpm --filter @repo/server typecheck",
    "format": "prettier . --write",
    "check": "expo lint && prettier . --check && pnpm run typecheck",
    "rename": "tsx scripts/rename-project.ts",
    "server:dev": "pnpm --filter @repo/server dev",
    "server:build": "pnpm --filter @repo/server build",
    "server:test": "pnpm --filter @repo/server test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/elements": "^2.9.15",
    "@react-navigation/native": "^7.2.2",
    "@repo/server": "workspace:*",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.6",
    "@trpc/client": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "expo": "~55.0.18",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-image": "~55.0.9",
    "expo-linking": "~55.0.14",
    "expo-network": "~55.0.13",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "heroui-native": "^1.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "~1.21.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.4",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "uniwind": "^1.6.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "connect": "^3.7.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serve-sim": "^0.1.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/bottom-tabs",
        "@react-navigation/native",
        "react-native-keyboard-controller",
        "react-native-screens"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/testing-utils/jest-setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/testing-utils/jest-after-env.ts"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx,js,jsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx,js,jsx}",
      "!src/**/*.spec.{ts,tsx,js,jsx}",
      "!src/**/index.{ts,tsx,js,jsx}"
    ],
    "coverageDirectory": "coverage/app",
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg|react-native-worklets|react-native-reanimated|react-native-keyboard-controller|react-native-gesture-handler|react-native-safe-area-context|heroui-native|uniwind|tailwind-variants|superjson|copy-anything|is-what))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@tests/(.*)$": "<rootDir>/tests/$1"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
