{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "packages/typescript-config/base.json"
  ],
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**"]
    },
    "@repo/typescript-config#compile": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^compile"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^compile"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^compile"],
      "outputs": ["coverage/**"]
    },
    "@repo/mobile#test": {
      "dependsOn": ["^compile"],
      "outputs": ["coverage/**"],
      // Babel inlines EXPO_PUBLIC_* into the bundle, so they belong in the cache key.
      // Declare any new EXPO_PUBLIC_* variable here too.
      "env": ["EXPO_OS", "EXPO_PUBLIC_API_URL"]
    },
    "build": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@repo/api#build": {
      "dependsOn": ["^compile"],
      "outputs": [".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^compile"]
    }
  }
}
